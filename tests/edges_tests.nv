// edges_tests.nv — every refusal's message, and the answers at the
// edges of the tree, the lookups and the grammar.
//
// The toml-test corpus in `vectors_tests.nv` covers the grammar as the
// specification states it.  This suite covers what the corpus does not
// reach: each `TomlError` arm rendered as a line, each typed read
// refusing each other type, and the few spellings the corpus has no
// case for.

use std.test
use std.bytes
use std.str
use std.math
use civil
use tomlnode
use tomlerror
use tomlkeys
use tomlread

fn refusal(src: Str) -> Str
    match tomlread.parse(src)
        Ok(_)  => "accepted"
        Err(e) => tomlerror.render(e, "f")

@test
fn test_every_refusal_renders_as_one_line() [io]
    test.case("each arm names the rule")
    test.assert(tomlerror.render(UnterminatedString(1, 5), "f") == "f:1:5: a string was never closed")
    test.assert(tomlerror.render(BadEscape(1, 2, "\\q"), "f") == "f:1:2: \\q is not an escape TOML defines")
    test.assert(tomlerror.render(BadUnicodeEscape(1, 2, 55296), "f") == "f:1:2: a Unicode escape names 55296, which is not a Unicode scalar value")
    test.assert(tomlerror.render(DuplicateKey(2, 1, "a", 1), "f") == "f:2:1: `a` is already defined, on line 1")
    test.assert(tomlerror.render(BadTableHeader(1, 3, "is not closed with ]"), "f") == "f:1:3: a table header is not closed with ]")
    test.assert(tomlerror.render(TableKindMismatch(1, 3, "a"), "f") == "f:1:3: `a` is a table and an array of tables at once")
    test.assert(tomlerror.render(BadInteger(1, 5, "01"), "f") == "f:1:5: `01` is not a TOML integer")
    test.assert(tomlerror.render(BadFloat(1, 5, "1."), "f") == "f:1:5: `1.` is not a TOML float")
    test.assert(tomlerror.render(BadDateTime(1, 5, "1979-02-30", "no such day"), "f") == "f:1:5: `1979-02-30` is not a date or time: no such day")
    test.assert(tomlerror.render(BadValue(1, 5, "yes"), "f") == "f:1:5: `yes` is not a TOML value here")
    test.assert(tomlerror.render(UnterminatedInline(1, 5), "f") == "f:1:5: an inline table or array was not closed on its line")
    test.assert(tomlerror.render(UnexpectedByte(1, 5, 255), "f") == "f:1:5: the byte 0xFF cannot appear here")
    test.assert(tomlerror.render(TooDeep(1, 5, 2), "f") == "f:1:5: values are nested deeper than 2")
    test.assert(tomlerror.render(WrongType("a", "integer", "array"), "f") == "f: `a` is an array, not an integer")
    test.assert(tomlerror.render(WrongType("a", "table", "offset date-time"), "f") == "f: `a` is an offset date-time, not a table")
    test.assert(tomlerror.render(Transport(IoClosed), "f") == "f: the stream failed: closed")

    test.case("and each positioned arm answers its column")
    test.assert(tomlerror.col_of(TableKindMismatch(4, 9, "a")) == 9)
    test.assert(tomlerror.line_of(Transport(IoClosed)) == 0 - 1)

@test
fn test_the_spellings_the_corpus_has_no_case_for() [io]
    test.case("a carriage return alone after a value")
    test.assert(refusal("a = 1\r") == "f:1:6: the byte 0x0D cannot appear here")

    test.case("an inline table nested past the bound")
    match tomlread.parse_with_depth("a = { b = { c = 1 } }\n", 1)
        Err(TooDeep(_, c, limit)) =>
            test.assert(limit == 1)
            test.assert(c == 11)
        _                         => test.fail("two inline tables exceed a bound of 1")

    test.case("a multi-line string opened with a carriage return and a line feed")
    match tomlread.parse("s = \"\"\"\r\nab\"\"\"\n")
        Ok(doc) => test.assert(tomlkeys.opt_str(doc, "s") == Some("ab"))
        Err(_)  => test.fail("the first line ending is dropped")

    test.case("a backslash at the very end of a multi-line string")
    test.assert(refusal("s = \"\"\"a\\") == "f:1:9: \\ is not an escape TOML defines")

    test.case("a hexadecimal integer past the range")
    test.assert(refusal("n = 0x8000000000000000\n") == "f:1:5: `0x8000000000000000` is not a TOML integer")

    test.case("a float past the range")
    test.assert(refusal("f = 1e999\n") == "f:1:5: `1e999` is not a TOML float")

    test.case("text straight after a time")
    test.assert(str.starts_with(refusal("t = 07:32:00x\n"), "f:1:5: `07:32:00x` is not a date or time"))

    test.case("a three-byte character whose first byte is E0")
    match tomlread.parse("s = \"\u{800}\"\n")
        Ok(doc) => test.assert(tomlkeys.opt_str(doc, "s") == Some("\u{800}"))
        Err(_)  => test.fail("U+0800 is valid UTF-8")
    match tomlread.parse_bytes(bytes.from_byte_list([115, 32, 61, 32, 34, 224, 128, 128, 34]))
        Ok(_)  => test.fail("E0 80 80 is an overlong form")
        Err(e) => test.assert(e == UnexpectedByte(1, 6, 224))

    test.case("a single value that is not UTF-8")
    match tomlread.parse_value("\"\xff\"")
        Ok(_)  => test.fail("0xFF is not UTF-8")
        Err(e) => test.assert(e == UnexpectedByte(1, 2, 255))

    test.case("a path with text after its last key")
    match tomlkeys.path_segments("a b")
        Ok(_)  => test.fail("`a b` is not a path")
        Err(e) => test.assert(e == BadKey(1, 3, "a b"))

    test.case("check answers the first fault")
    test.assert(tomlread.check("a = 1\na = 2\n") == Some(DuplicateKey(2, 1, "a", 1)))

@test
fn test_equal_compares_every_arm() [io]
    let d = civil.date(1979, 5, 27)!
    let tm = civil.time_of(7, 32, 0, 0)!
    let dt = civil.datetime(d, tm)
    let other = civil.datetime(d, civil.time_of(8, 0, 0, 0)!)

    test.case("each arm against itself and against its neighbour")
    test.assert(tomlnode.equal(TomlStr("a"), TomlStr("a")) and not tomlnode.equal(TomlStr("a"), TomlInt(1)))
    test.assert(tomlnode.equal(TomlInt(1), TomlInt(1)) and not tomlnode.equal(TomlInt(1), TomlStr("1")))
    test.assert(tomlnode.equal(TomlBool(true), TomlBool(true)) and not tomlnode.equal(TomlBool(true), TomlInt(1)))
    test.assert(not tomlnode.equal(TomlFloat(1.0), TomlInt(1)))
    test.assert(tomlnode.equal(TomlFloat(math.nan()), TomlFloat(math.nan())))
    test.assert(not tomlnode.equal(TomlOffsetDateTime(dt, 0), TomlOffsetDateTime(dt, 60)))
    test.assert(not tomlnode.equal(TomlOffsetDateTime(dt, 0), TomlOffsetDateTime(other, 0)))
    test.assert(tomlnode.equal(TomlLocalDateTime(dt), TomlLocalDateTime(dt)))
    test.assert(not tomlnode.equal(TomlLocalDateTime(dt), TomlLocalDate(d)))
    test.assert(tomlnode.equal(TomlLocalDate(d), TomlLocalDate(d)) and not tomlnode.equal(TomlLocalDate(d), TomlLocalTime(tm)))
    test.assert(tomlnode.equal(TomlLocalTime(tm), TomlLocalTime(tm)) and not tomlnode.equal(TomlLocalTime(tm), TomlLocalDate(d)))

    test.case("containers compare their length, their keys and their items")
    test.assert(not tomlnode.equal(TomlArray([TomlInt(1)]), TomlArray([])))
    test.assert(not tomlnode.equal(TomlArray([TomlInt(1)]), TomlArray([TomlInt(2)])))
    test.assert(tomlnode.equal(TomlArray([TomlInt(1)]), TomlArray([TomlInt(1)])))
    test.assert(not tomlnode.equal(TomlArray([]), tomlnode.empty_table()))
    test.assert(not tomlnode.equal(tomlnode.empty_table(), TomlArray([])))
    test.assert(not tomlnode.equal(tomlnode.table([TomlPair { key: "a", value: TomlInt(1) }]), tomlnode.empty_table()))

    test.case("every type has its name")
    test.assert(tomlnode.type_name(TomlOffsetDateTime(dt, 0)) == "offset date-time")
    test.assert(tomlnode.type_name(TomlLocalDateTime(dt)) == "local date-time")
    test.assert(tomlnode.type_name(TomlLocalDate(d)) == "local date")
    test.assert(tomlnode.type_name(TomlLocalTime(tm)) == "local time")

@test
fn test_every_typed_read_refuses_every_other_type() [io]
    let doc = tomlread.parse("s = \"x\"\nf = 1.5\nb = true\na = [1]\nt = 07:00:00\nd = 1979-05-27\n")!

    test.case("a path through a value that is not a table")
    test.assert(tomlkeys.get(doc, "s.x") == Err(WrongType("s", "table", "string")))

    test.case("child of something that is not a table")
    test.assert(tomlkeys.child(TomlInt(1), "a") == None)

    test.case("an optional read of a value that is there")
    test.assert(tomlkeys.opt_int(tomlread.parse("n = 3\n")!, "n") == Some(3))

    test.case("each read on a string")
    test.assert(tomlkeys.float_at(doc, "f") == Ok(1.5))
    test.assert(tomlkeys.opt_float(doc, "f") == Some(1.5))
    test.assert(tomlkeys.bool_at(doc, "s") == Err(WrongType("s", "boolean", "string")))
    test.assert(tomlkeys.array_at(doc, "s") == Err(WrongType("s", "array", "string")))
    test.assert(tomlkeys.local_datetime_at(doc, "d") == Err(WrongType("d", "local date-time", "local date")))
    test.assert(tomlkeys.time_at(doc, "d") == Err(WrongType("d", "local time", "local date")))

    test.case("set and merge need a table at the root")
    test.assert(tomlkeys.set(TomlInt(1), "a", TomlInt(2)) == Err(WrongType("", "table", "integer")))
    test.assert(tomlkeys.merge(TomlInt(1), doc) == Err(WrongType("", "table", "integer")))
    test.assert(tomlkeys.merge(doc, TomlInt(1)) == Err(WrongType("", "table", "integer")))

    test.case("merge appends a key only the overlay has")
    match tomlkeys.merge(doc, tomlnode.table([TomlPair { key: "new", value: TomlInt(1) }]))
        Ok(m)  =>
            test.assert(tomlnode.len(m) == 7)
            test.assert(tomlnode.keys(m)[6] == "new")
        Err(_) => test.fail("two tables merge")
