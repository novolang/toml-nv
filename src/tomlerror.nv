// tomlerror.nv — every way a TOML document can refuse to be read, and
// where in the file the reader has to go and look.
//
// A TOML file is edited by hand, so a refusal carries the line and the
// column of the byte a person has to fix.  Every reason that has a
// position carries it in the variant.  The three that have none, a key
// the document does not have, a value of the wrong type and a stream
// that failed, answer `-1` from `line_of` and `col_of`, because line 0
// does not exist.
//
// Lines and columns are both 1-based, and the column is a byte offset
// into the line: what an editor's status bar shows.  A document that is
// not valid UTF-8 is the one a person most needs a position for, and a
// byte offset can always be produced.
//
// There is no "unsupported" arm.  This package parses TOML 1.0.0 whole,
// so a document it refuses is one the specification refuses, and the
// variant says which rule.

use std.str

// Why a TOML document, or a request about a parsed one, could not be
// answered.
//
// ```novo
// use tomlerror
//
// fn main() [io]
//     let e = UnterminatedString(41, 12)
//     println("line ${tomlerror.line_of(e)}, col ${tomlerror.col_of(e)}")
// ```
pub enum TomlError
    // A basic or literal string was still open when the line ended,
    // or, for a multi-line string, when the document ended.  The
    // position is the opening delimiter, which is the byte to fix.
    UnterminatedString(line: Int, col: Int)
    // An escape sequence inside a basic string that TOML 1.0.0 section
    // "String" does not define.  `seq` is the escape as written,
    // backslash included.
    BadEscape(line: Int, col: Int, seq: Str)
    // A `\uXXXX` or `\UXXXXXXXX` escape naming a number that is not a
    // Unicode scalar value: a surrogate, or past U+10FFFF.  `value` is
    // the number that was written.
    BadUnicodeEscape(line: Int, col: Int, value: Int)
    // A bare key containing a byte that is not `A-Za-z0-9_-`, or an
    // empty key where the grammar requires one.  `text` is what stood
    // in the key position.
    BadKey(line: Int, col: Int, text: Str)
    // A key defined twice in the same table, a table defined twice, or
    // a dotted key that reaches into a table a header defined.  `key`
    // is the dotted path, and `first_line` is where it was defined the
    // first time.
    DuplicateKey(line: Int, col: Int, key: Str, first_line: Int)
    // A `[table]` or `[[array.of.tables]]` header that is malformed or
    // unclosed.  `why` says which rule, as a sentence.
    BadTableHeader(line: Int, col: Int, why: Str)
    // A `[[name]]` appended to a `name` that is not an array of
    // tables, or a `[name]` opened on one that is.
    TableKindMismatch(line: Int, col: Int, key: Str)
    // An integer literal outside the signed 64-bit range, with a
    // leading zero, or with a misplaced underscore.  `text` is the
    // literal as written.
    BadInteger(line: Int, col: Int, text: Str)
    // A float literal that is not one of TOML's spellings: a bare
    // `.5`, a trailing `1.`, an exponent with no digits, or a misplaced
    // underscore.  `inf` and `nan` are floats and do not come here.
    BadFloat(line: Int, col: Int, text: Str)
    // A date-time literal the RFC 3339 subset does not accept: a month
    // of 13, a February 30th, an offset of `+25:00`, a `T` with nothing
    // after it.  `text` is the literal.  `cause` is calendar-nv's own
    // message for a date or time that does not exist, and a short
    // description of the shape otherwise.
    BadDateTime(line: Int, col: Int, text: Str, cause: Str)
    // A value position holding something that is not a TOML value: a
    // bare word that is not `true`, `false`, `inf` or `nan`, a missing
    // right-hand side, text after a value on its line, or a trailing
    // comma in an inline table.
    BadValue(line: Int, col: Int, text: Str)
    // An inline table spanning a newline, or an inline table or array
    // that was never closed.  TOML 1.0.0 section "Inline Table" forbids
    // the newline.
    UnterminatedInline(line: Int, col: Int)
    // A byte that cannot appear where it appeared: a control
    // character in a string or a comment, a carriage return not
    // followed by a line feed, a byte that is not UTF-8.  `byte` is its
    // value.
    UnexpectedByte(line: Int, col: Int, byte: Int)
    // A value nested arrays and inline tables deeper than `limit`.  The
    // parser refuses at a named depth rather than overflowing a stack.
    // `tomlread.default_depth` is what `parse` uses.
    TooDeep(line: Int, col: Int, limit: Int)
    // A lookup or a typed read asked for a key the document does not
    // have.  There is no position: the fault is in the caller's path.
    // `path` is the dotted path as the caller wrote it.
    NoSuchKey(path: Str)
    // A typed read found a value of the wrong kind: `int_at` on a
    // string, `table_at` on an array.  `want` and `got` are
    // `tomlnode.type_name` spellings, and `path` is where.  There is no
    // position.
    WrongType(path: Str, want: Str, got: Str)
    // The stream underneath `tomlread.read_all` failed.  The host's
    // error is carried through unmodified, so the caller can still
    // tell a timeout from a truncated file.
    Transport(cause: IoError)

// `Result<T, TomlError>` requires the `Error` trait (SPEC section 3.4).
impl Error for TomlError
    // The one-line message, for a caller that is printing rather than
    // matching.
    //
    // The sentence names the rule the document broke.  It does not
    // include the position: `line_of` and `col_of` are separate, and
    // `render` puts the three together.
    fn message(self) -> Str
        match self
            UnterminatedString(_, _)       => "a string was never closed"
            BadEscape(_, _, seq)           => "${seq} is not an escape TOML defines"
            BadUnicodeEscape(_, _, value)  => "a Unicode escape names ${value}, which is not a Unicode scalar value"
            BadKey(_, _, text)             => "`${text}` is not a key"
            DuplicateKey(_, _, key, first) =>
                if first > 0
                    return "`${key}` is already defined, on line ${first}"
                "`${key}` is defined twice"
            BadTableHeader(_, _, why)      => "a table header ${why}"
            TableKindMismatch(_, _, key)   => "`${key}` is a table and an array of tables at once"
            BadInteger(_, _, text)         => "`${text}` is not a TOML integer"
            BadFloat(_, _, text)           => "`${text}` is not a TOML float"
            BadDateTime(_, _, text, cause) => "`${text}` is not a date or time: ${cause}"
            BadValue(_, _, text)           => "`${text}` is not a TOML value here"
            UnterminatedInline(_, _)       => "an inline table or array was not closed on its line"
            UnexpectedByte(_, _, byte)     => "the byte 0x${hex2(byte)} cannot appear here"
            TooDeep(_, _, limit)           => "values are nested deeper than ${limit}"
            NoSuchKey(path)                => "there is no key `${path}`"
            WrongType(path, want, got)     => "`${path}` is ${article(got)}${got}, not ${article(want)}${want}"
            Transport(cause)               => "the stream failed: ${cause.message()}"

// The 1-based line, or `-1` for the three reasons that have no
// position.
//
// ```novo
// use tomlerror
//
// fn main() [io]
//     println("${tomlerror.line_of(NoSuchKey("db.host"))}")   // -1
// ```
pub fn line_of(e: TomlError) -> Int
    position(e).0

// The 1-based byte column within that line, or `-1`.
//
// ```novo
// use tomlerror
//
// fn main() [io]
//     println("${tomlerror.col_of(BadKey(3, 1, "a b"))}")     // 1
// ```
pub fn col_of(e: TomlError) -> Int
    position(e).1

// `file:line:col: message`, the form an editor's error list parses.
//
// `path` is the caller's: this package never opens a file.  A reason
// with no position renders as `file: message`.
//
// ```novo
// use tomlerror
//
// fn main() [io]
//     println(tomlerror.render(BadKey(3, 1, "a b"), "novo.toml"))
// ```
pub fn render(e: TomlError, path: Str) -> Str
    let (line, col) = position(e)
    if line < 0
        return "${path}: ${e.message()}"
    "${path}:${line}:${col}: ${e.message()}"

// The line and column of a fault, or `(-1, -1)`.
fn position(e: TomlError) -> (Int, Int)
    match e
        UnterminatedString(l, c)   => (l, c)
        BadEscape(l, c, _)         => (l, c)
        BadUnicodeEscape(l, c, _)  => (l, c)
        BadKey(l, c, _)            => (l, c)
        DuplicateKey(l, c, _, _)   => (l, c)
        BadTableHeader(l, c, _)    => (l, c)
        TableKindMismatch(l, c, _) => (l, c)
        BadInteger(l, c, _)        => (l, c)
        BadFloat(l, c, _)          => (l, c)
        BadDateTime(l, c, _, _)    => (l, c)
        BadValue(l, c, _)          => (l, c)
        UnterminatedInline(l, c)   => (l, c)
        UnexpectedByte(l, c, _)    => (l, c)
        TooDeep(l, c, _)           => (l, c)
        _                          => (0 - 1, 0 - 1)

// A byte as two upper-case hexadecimal digits.
fn hex2(b: Int) -> Str
    let digits = "0123456789ABCDEF"
    str.slice(digits, b / 16 % 16, b / 16 % 16 + 1) + str.slice(digits, b % 16, b % 16 + 1)

// "an " before a type name that starts with a vowel, "a " otherwise.
fn article(name: Str) -> Str
    let first = str.byte_at_or(name, 0, 0)
    if first == 'a' or first == 'i' or first == 'o'
        return "an "
    "a "
