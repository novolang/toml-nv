// tomlnode.nv — the value tree.
//
// TOML has four date-time forms, and the tree holds them in
// calendar-nv's civil types, so a program that reads a timestamp out
// of a configuration file and compares it with a date from anywhere
// else holds one type:
//
//     TOML form            arm                       carries
//     ------------------   -----------------------   --------------------------------
//     offset date-time     TomlOffsetDateTime        civil.CivilDateTime + offset_min
//     local date-time      TomlLocalDateTime         civil.CivilDateTime
//     local date           TomlLocalDate             civil.CivilDate
//     local time           TomlLocalTime             civil.CivilTime
//
// `offset_min` is minutes east of UTC: `+02:00` is `120`, `-05:30` is
// `-330`, and `Z` is `0`.  It sits beside the civil date-time because
// TOML's offset is a fixed number of minutes and not a zone.
// calendar-nv's `iso8601.parse_rfc3339` answers the same pair.
//
// A table is an ordered list of pairs, not a map.  A writer keeps the
// document's order, and a duplicate key, which the specification
// requires a parser to refuse, stays representable.  Lookup is
// `tomlkeys.get`, a scan.

use std.math
use civil

// A TOML value: every form the grammar has, and nothing else.
//
// `TomlTable` and `TomlArray` are the two that nest.  There is no
// null arm because TOML has no null: a key that is absent is absent,
// which is `?TomlValue` at the lookup and not a value in the tree.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     let v = TomlInt(8080)
//     println(tomlnode.type_name(v))            // "integer"
// ```
pub enum TomlValue
    // A table: its pairs in the order the document wrote them.  Both
    // `[header]` tables and `{ inline = "tables" }` land here; the
    // difference is a spelling, and `tomledit` is where a document
    // remembers which one it had.
    TomlTable(pairs: [TomlPair])
    // An array.  TOML 1.0.0 dropped the same-type requirement, so this
    // is a list of anything.  An array of tables is this with
    // `TomlTable` arms in it.
    TomlArray(items: [TomlValue])
    // A string, already unescaped and with the multi-line forms'
    // leading newline and line-ending backslashes applied.  What is
    // here is the value; how it was spelled is `tomledit`'s business.
    TomlStr(value: Str)
    // A signed 64-bit integer.  TOML 1.0.0 section "Integer" requires
    // exactly that range, so a literal outside it is `BadInteger` at
    // parse time rather than a wrapped value here.
    TomlInt(value: Int)
    // A 64-bit float, `inf` and `nan` included: TOML spells them
    // `inf`, `+inf`, `-inf` and `nan`, and they are values.
    TomlFloat(value: Float)
    // `true` or `false`, the only two spellings TOML accepts.  `True`
    // and `yes` are `BadValue`.
    TomlBool(value: Bool)
    // An offset date-time: the civil parts, and minutes east of UTC.
    TomlOffsetDateTime(when: civil.CivilDateTime, offset_min: Int)
    // A local date-time: a wall-clock reading with no offset at all.
    // It is not an offset date-time with `offset_min = 0`: `Z` is a
    // claim about UTC and no offset makes no claim.
    TomlLocalDateTime(when: civil.CivilDateTime)
    // A local date: a calendar day with no time and no offset.
    TomlLocalDate(day: civil.CivilDate)
    // A local time: a time of day with no date and no offset.
    TomlLocalTime(at: civil.CivilTime)

// One key and its value, in document order.
//
// `key` is the key as a value: unquoted and unescaped, the string a
// caller compares against.  A bare key, a quoted key and a literal key
// that spell the same characters produce the same `key`, which is what
// makes `a.b`, `a."b"` and `"a".b` the same path (TOML 1.0.0 section
// "Keys").
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     let p = TomlPair { key: "port", value: TomlInt(8080) }
//     println(p.key)                            // port
// ```
pub struct TomlPair
    // The key, unquoted and unescaped.
    key: Str
    // What it is bound to.
    value: TomlValue

// Which arm a value is, as a value a caller can match or print.
//
// `WrongType`'s `want` and `got` are these, spelled by `type_name`.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     match tomlnode.type_of(TomlBool(true))
//         TypeBool => println("a boolean")
//         _        => println("something else")
// ```
pub enum TomlType
    TypeTable
    TypeArray
    TypeStr
    TypeInt
    TypeFloat
    TypeBool
    TypeOffsetDateTime
    TypeLocalDateTime
    TypeLocalDate
    TypeLocalTime

// The type of a value.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     match tomlnode.type_of(TomlArray([]))
//         TypeArray => println("array")
//         _         => println("not an array")
// ```
pub fn type_of(v: TomlValue) -> TomlType
    match v
        TomlTable(_)             => TypeTable
        TomlArray(_)             => TypeArray
        TomlStr(_)               => TypeStr
        TomlInt(_)               => TypeInt
        TomlFloat(_)             => TypeFloat
        TomlBool(_)              => TypeBool
        TomlOffsetDateTime(_, _) => TypeOffsetDateTime
        TomlLocalDateTime(_)     => TypeLocalDateTime
        TomlLocalDate(_)         => TypeLocalDate
        TomlLocalTime(_)         => TypeLocalTime

// The type's name in the spelling TOML's own specification uses:
// `"table"`, `"array"`, `"string"`, `"integer"`, `"float"`,
// `"boolean"`, `"offset date-time"`, `"local date-time"`,
// `"local date"`, `"local time"`.
//
// These are the strings `WrongType` carries.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     println(tomlnode.type_name(TomlFloat(1.5)))   // float
// ```
pub fn type_name(v: TomlValue) -> Str
    type_label(type_of(v))

// An empty table, which is what an empty document parses to.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     println("${tomlnode.len(tomlnode.empty_table())}")   // 0
// ```
pub fn empty_table() -> TomlValue
    let none: [TomlPair] = []
    TomlTable(none)

// A table from pairs, in the order given.
//
// It does not check for duplicate keys.  `tomlwrite.check` is where a
// tree is held to the document rules before it is written out.  The
// table holds its own copy of the list.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     let t = tomlnode.table([TomlPair { key: "n", value: TomlInt(1) }])
//     println("${tomlnode.len(t)}")             // 1
// ```
pub fn table(pairs: [TomlPair]) -> TomlValue
    TomlTable(pairs[:])

// How many pairs a table has, or how many items an array has.
//
// `0` for a scalar.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     println("${tomlnode.len(TomlArray([TomlInt(1), TomlInt(2)]))}")  // 2
// ```
pub fn len(v: TomlValue) -> Int
    match v
        TomlTable(pairs) => list.len(pairs)
        TomlArray(items) => list.len(items)
        _                => 0

// A table's keys, in document order.
//
// An empty list for anything that is not a table.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     let t = tomlnode.table([TomlPair { key: "a", value: TomlInt(1) }])
//     println("${list.len(tomlnode.keys(t))}")  // 1
// ```
pub fn keys(v: TomlValue) -> [Str]
    var out: [Str] = []
    if let TomlTable(pairs) = v
        for p in pairs
            list.push(out, p.key)
    out

// Two values compared structurally: the same arm, the same contents,
// and for tables the same pairs in the same order.
//
// Two floats that are both not a number are equal here, so a document
// holding `nan` equals itself after a round trip.  Two offset
// date-times are equal when their civil parts and their offsets are.
// Order matters because these are documents; a caller who wants the
// comparison without order sorts the keys first.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     println("${tomlnode.equal(TomlInt(1), TomlInt(1))}")   // true
// ```
pub fn equal(a: TomlValue, b: TomlValue) -> Bool
    match a
        TomlTable(xs) =>
            if let TomlTable(ys) = b
                if list.len(xs) != list.len(ys)
                    return false
                for i in 0..list.len(xs)
                    if xs[i].key != ys[i].key or not equal(xs[i].value, ys[i].value)
                        return false
                return true
            false
        TomlArray(xs) =>
            if let TomlArray(ys) = b
                if list.len(xs) != list.len(ys)
                    return false
                for i in 0..list.len(xs)
                    if not equal(xs[i], ys[i])
                        return false
                return true
            false
        TomlFloat(x)  =>
            if let TomlFloat(y) = b
                return x == y or math.is_nan(x) and math.is_nan(y)
            false
        _             => a == b

// The nesting depth of a value: `0` for a scalar, `1` for a table or
// array of scalars, and so on.
//
// A caller about to hand a tree to something with a recursion limit
// of its own finds out with this first.
//
// ```novo
// use tomlnode
//
// fn main() [io]
//     println("${tomlnode.depth(TomlArray([TomlArray([])]))}")   // 2
// ```
pub fn depth(v: TomlValue) -> Int
    var deepest = 0
    match v
        TomlTable(pairs) =>
            for p in pairs
                deepest = math.max(deepest, depth(p.value))
            1 + deepest
        TomlArray(items) =>
            for x in items
                deepest = math.max(deepest, depth(x))
            1 + deepest
        _                => 0

// The name of a type, in the specification's spelling.
fn type_label(t: TomlType) -> Str
    match t
        TypeTable          => "table"
        TypeArray          => "array"
        TypeStr            => "string"
        TypeInt            => "integer"
        TypeFloat          => "float"
        TypeBool           => "boolean"
        TypeOffsetDateTime => "offset date-time"
        TypeLocalDateTime  => "local date-time"
        TypeLocalDate      => "local date"
        TypeLocalTime      => "local time"
