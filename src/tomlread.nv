// tomlread.nv — the parser: text in, a value tree or a position out.
//
// There is no chunk-at-a-time reader.  A CSV record is complete at a
// separator, but a TOML document is not complete until its last line,
// because a `[table]` header far down can still add keys to a table
// defined at the top.  A streaming reader would have to hold the whole
// document anyway.  So `parse` takes the text, and `read_all`, the one
// function that meets a stream, reads it to the end and then parses.
//
// `read_all` stays inside a `core` package's effect budget by binding
// its cost rather than spending one:
//
//     pub fn read_all<S: Read[e]>(src: S) -> Result<TomlValue, TomlError> [e]
//
// `S: Read[e]` binds the effect parameter of the standard library's
// `Read` trait, and the clause uses it (SPEC section 5.6), so the row
// is whatever the impl behind `S` supplies: `[io, fs]` for a file,
// nothing for an in-memory buffer.
//
// `std.toml`, the toolchain's own manifest reader, parses a subset of
// TOML onto the JSON value tree and answers `None` for a document it
// cannot read, with no reason and no position.  This module is the
// whole of TOML 1.0.0, with the line and the column of every refusal.

use std.bytes
use tomlparse
use tomlnode
use tomlerror

// Parse a whole TOML document.
//
// The result is always a `TomlTable`.  A TOML document is a table,
// and an empty document is an empty table, so `""` is `Ok`.
//
// Nesting is bounded at `default_depth`; `parse_with_depth` is the
// same function with the bound as a parameter.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     match tomlread.parse("port = 8080\n")
//         Ok(doc) => println("${tomlkeys.int_at(doc, "port")!}")   // 8080
//         Err(e)  => println(e.message())
// ```
pub fn parse(text: Str) -> Result<TomlValue, TomlError>
    parse_with_depth(text, default_depth())

// `parse` with the nesting bound named.
//
// The bound counts arrays and inline tables nested inside one another
// in a value.  The parser refuses at that depth with `TooDeep`, which
// carries the limit, rather than overflowing a stack.
//
// ```novo
// use tomlread
//
// fn main() [io]
//     match tomlread.parse_with_depth("a = [[1]]\n", 2)
//         Ok(_)  => println("fits")
//         Err(_) => println("too deep")
// ```
pub fn parse_with_depth(text: Str, max_depth: Int) -> Result<TomlValue, TomlError>
    match tomlparse.parse_document(text, max_depth)
        Ok(d)  => Ok(d.value)
        Err(e) => Err(e)

// The nesting bound `parse` uses: 64.
//
// Deep enough that no document a person wrote reaches it, and shallow
// enough that the recursion fits a small stack.
//
// ```novo
// use tomlread
//
// fn main() [io]
//     println("${tomlread.default_depth()}")    // 64
// ```
pub fn default_depth() -> Int
    64

// Parse the bytes of a document.
//
// The same parser.  TOML documents are UTF-8 by specification, and a
// `Bytes` that is not valid UTF-8, or holds a zero byte, is
// `UnexpectedByte` at the offending byte, with its line and column.
//
// ```novo
// use tomlread
//
// fn main() [io]
//     match tomlread.parse_bytes(bytes.from_str("a = 1\n"))
//         Ok(_)  => println("ok")
//         Err(_) => println("not toml")
// ```
pub fn parse_bytes(input: Bytes) -> Result<TomlValue, TomlError>
    parse_bytes_with_depth(input, default_depth())

// Parse a single TOML value: the right-hand side of a `=`, with no key
// and no document around it.
//
// For a command line taking `--set timeout=30.5`, a test fixture, or
// an editor evaluating the expression under the cursor.  Blanks around
// the value are allowed; any other text after it is `BadValue`.
//
// ```novo
// use tomlread
// use tomlnode
//
// fn main() [io]
//     match tomlread.parse_value("1979-05-27T07:32:00Z")
//         Ok(v)  => println(tomlnode.type_name(v))   // offset date-time
//         Err(_) => println("no")
// ```
pub fn parse_value(text: Str) -> Result<TomlValue, TomlError>
    tomlparse.parse_one_value(text, default_depth())

// Read a whole stream and parse what it held, charged exactly what the
// stream costs.
//
// `S: Read[e]` binds the effect parameter of `Read` and the clause is
// `[e]`, so the caller is charged what its own impl declared (SPEC
// section 5.6).  A `File` costs the caller `[io, fs]`, and an in-memory
// `Buffer` costs nothing.
//
// The stream is read in chunks of 4096 bytes until a read answers
// none.  Its own failure is carried through as `Transport`, so a
// caller can still tell a truncated read from a malformed document.
//
// ```novo
// use tomlread
//
// fn load(path: Str) -> Result<TomlValue, TomlError> [io, fs]
//     match File.open_read(path)
//         None    => Err(Transport(IoNotFound))
//         Some(f) =>
//             let h: File = f
//             tomlread.read_all(h)
//
// fn main() [io, fs]
//     match load("config.toml")
//         Ok(_)  => println("loaded")
//         Err(e) => println(tomlerror.render(e, "config.toml"))
// ```
pub fn read_all<S: Read[e]>(src: S) -> Result<TomlValue, TomlError> [e]
    read_all_with_depth(src, default_depth())

// `read_all` with the nesting bound named.
//
// ```novo
// use tomlread
//
// fn load(f: File) -> Result<TomlValue, TomlError> [io, fs]
//     tomlread.read_all_with_depth(f, 16)
//
// fn main() [io, fs]
//     match File.open_read("config.toml")
//         None    => println("no such file")
//         Some(f) =>
//             let h: File = f
//             match load(h)
//                 Ok(_)  => println("loaded")
//                 Err(_) => println("bad document")
// ```
pub fn read_all_with_depth<S: Read[e]>(src: S, max_depth: Int) -> Result<TomlValue, TomlError> [e]
    var chunks: [Bytes] = []
    loop
        match src.read(4096)
            Err(e)    =>
                return Err(Transport(e))
            Ok(chunk) =>
                if bytes.len(chunk) == 0
                    break
                list.push(chunks, bytes.clone(chunk))
    parse_bytes_with_depth(bytes.concat(chunks), max_depth)

// The line and column a parse would stop at, for a caller that wants
// to check a document without keeping the tree.
//
// `None` when the document parses.  It is `parse` with the `Ok` arm
// dropped, for a linter, a pre-commit hook or an editor's save
// handler.
//
// ```novo
// use tomlread
//
// fn main() [io]
//     match tomlread.check("a = = 1\n")
//         Some(e) => println(e.message())
//         None    => println("valid")
// ```
pub fn check(text: Str) -> ?TomlError
    match parse(text)
        Ok(_)  => None
        Err(e) => Some(e)

// `parse_bytes` with the nesting bound named.  A zero byte is refused
// before the bytes become text, because the conversion stops at one.
fn parse_bytes_with_depth(input: Bytes, max_depth: Int) -> Result<TomlValue, TomlError>
    let n = bytes.len(input)
    var line = 1
    var start = 0
    for i in 0..n
        let b = bytes.byte_at(input, i) ?? 0
        if b == 0
            return Err(UnexpectedByte(line, i - start + 1, 0))
        if b == '\n'
            line = line + 1
            start = i + 1
    parse_with_depth(bytes.to_str(input), max_depth)
