// tomlwrite.nv — the writer that preserves nothing.
//
// This module renders a `TomlValue` and keeps nothing that was not in
// it: comments, blank lines, whether a table was a header or inline,
// whether a string was basic or literal.  What comes out is canonical,
// so the same tree always renders the same bytes.  That is what a
// program generating a file wants: a lock file, a manifest a scaffold
// writes, a fixture.
//
// A program editing a file a person maintains wants `tomledit`
// instead.  Through this writer, a tool that changes one version number
// hands the person a difference on every line, with their comments
// gone.
//
// The tree's order is the document's order, and it is kept: a key is
// never moved.  A table or an array of tables becomes a header only
// when every key after it in its table can become one too, because a
// `key = value` line after a header would belong to the header's table.
// A table that cannot become a header is written inline.  So
// `parse |> to_string |> parse` gives back an equal tree.
//
// Every function here answers a `Str` or `Bytes`; nothing is written
// anywhere.

use std.bytes
use std.math
use std.str
use iso8601
use tomlerror.{ TomlError }
use tomlnode
use tomlparse

// How a canonical document is spelled.
//
// `standard()` is the shape TOML's own examples have and the one to
// use unless something specific is wanted.
//
// ```novo
// use tomlwrite
//
// fn main() [io]
//     let s = tomlwrite.standard()
//     println("${s.indent}")                    // 0
// ```
pub struct TomlStyle
    // Spaces of indentation per level of header.  A header is
    // indented by its depth less one and the keys under it by its
    // depth, so `0`, the standard, leaves everything flush left.
    indent: Int
    // Write an array on one line while its line fits in this many
    // columns, and one item per line when it does not.  `0` means never
    // wrap.  Only the outermost array of a key wraps.
    array_width: Int
    // Write a blank line before each header that is not the first
    // line of the document.  `true` in the standard style.
    blank_before_table: Bool
    // Write a nested table as a `[header]` rather than inline.  `true`
    // in the standard style.  An array of tables is written as
    // `[[header]]`s either way.  Either way, a table is written inline
    // when a plain key follows it in its table, so that no key moves.
    prefer_headers: Bool

// The style TOML's own specification writes its examples in: no
// indentation, arrays wrapped past 80 columns, a blank line before
// each header, headers preferred over inline tables.
//
// ```novo
// use tomlwrite
// use tomlread
//
// fn main() [io]
//     let doc = tomlread.parse("a = 1\n")!
//     println(tomlwrite.to_string(doc, tomlwrite.standard())!)
// ```
pub fn standard() -> TomlStyle
    TomlStyle { indent: 0, array_width: 80, blank_before_table: true, prefer_headers: true }

// The most compact style: no indentation, no wrapping, no blank lines,
// and nested tables inline.
//
// For a generated file nobody reads, such as a cache or a value written
// to a socket.
//
// ```novo
// use tomlwrite
//
// fn main() [io]
//     println("${tomlwrite.compact().blank_before_table}")   // false
// ```
pub fn compact() -> TomlStyle
    TomlStyle { indent: 0, array_width: 0, blank_before_table: false, prefer_headers: false }

// Render a document.
//
// `v` must be a `TomlTable`, because a TOML document is a table.
// Anything else is `WrongType` with the path `""`, which is how this
// module names the root.  A tree `check` refuses is refused here with
// the same error.
//
// The result always ends in exactly one line ending; an empty table is
// a line ending and nothing else.
//
// ```novo
// use tomlread
// use tomlwrite
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     print(tomlwrite.to_string(doc, tomlwrite.standard())!)
// ```
pub fn to_string(v: TomlValue, style: TomlStyle) -> Result<Str, TomlError>
    if let Some(e) = check(v)
        return Err(e)
    var out = ""
    if let TomlTable(pairs) = v
        out = body(pairs, [], style, "")
    Ok(out + "\n")

// Render a document as bytes.
//
// UTF-8, the only encoding a TOML document has.
//
// ```novo
// use tomlread
// use tomlwrite
//
// fn main() [io]
//     let doc = tomlread.parse("a = 1\n")!
//     let b = tomlwrite.to_bytes(doc, tomlwrite.standard())!
//     println("${bytes.len(b)}")
// ```
pub fn to_bytes(v: TomlValue, style: TomlStyle) -> Result<Bytes, TomlError>
    Ok(bytes.from_str(to_string(v, style)!))

// Render one value, as it would appear on the right of an `=`.
//
// A string comes back as a basic string with the escapes TOML
// requires, an array on one line, a table inline, a float with a point
// or an exponent, and a date-time in RFC 3339 spelling with `Z` for an
// offset of zero.  `tomledit.set` writes new values with this.
//
// ```novo
// use tomlwrite
// use tomlnode
//
// fn main() [io]
//     println(tomlwrite.value_to_string(TomlStr("a\nb")))    // "a\nb"
// ```
pub fn value_to_string(v: TomlValue) -> Str
    match v
        TomlTable(pairs)            => inline_table(pairs)
        TomlArray(items)            =>
            var parts: [Str] = []
            for x in items
                list.push(parts, value_to_string(x))
            "[" + str.join(parts, ", ") + "]"
        TomlStr(text)               => tomlparse.basic_quoted(text)
        TomlInt(n)                  => "${n}"
        TomlFloat(f)                => float_text(f)
        TomlBool(b)                 => str.from_bool(b)
        TomlOffsetDateTime(dt, off) => iso8601.format_rfc3339(dt, off)
        TomlLocalDateTime(dt)       => iso8601.format_datetime(dt)
        TomlLocalDate(d)            => iso8601.format_date(d)
        TomlLocalTime(t)            => iso8601.format_time(t)

// A key written as a document spells it: bare when every byte is an
// ASCII letter, a digit, `_` or `-`, and a basic string otherwise.
//
// ```novo
// use tomlwrite
//
// fn main() [io]
//     println(tomlwrite.key_to_string("a-b"))   // a-b
//     println(tomlwrite.key_to_string("a b"))   // "a b"
// ```
pub fn key_to_string(key: Str) -> Str
    tomlparse.key_text(key)

// Whether a tree can be written as a TOML document at all, and why
// not.
//
// `to_string` runs this first.  A tree cannot be written when its root
// is not a table (`WrongType`), or when a table under it, in an array
// or not, has the same key twice (`DuplicateKey`, with the line, the
// column and `first_line` all `-1`, because a tree has no lines).  A
// `nan` or an `inf` is not a fault: TOML has spellings for both.  A
// tree that came out of `tomlread.parse` always passes.
//
// ```novo
// use tomlwrite
// use tomlnode
//
// fn main() [io]
//     match tomlwrite.check(TomlInt(1))
//         Some(_) => println("not a document")
//         None    => println("writable")
// ```
pub fn check(v: TomlValue) -> ?TomlError
    if tomlnode.type_of(v) != TypeTable
        return Some(WrongType("", "table", tomlnode.type_name(v)))
    duplicate_in(v, [])

// The lines of a table's body, without the final line ending.  `path`
// is the table's own path and `out` the text written so far, which
// says whether a header needs a blank line before it.
fn body(pairs: [TomlPair], path: [Str], style: TomlStyle, out: Str) -> Str
    var text = out
    let n = list.len(pairs)
    var split = n
    for _ in 0..n
        if split == 0 or not headed(pairs[split - 1].value, style)
            break
        split = split - 1
    let pad = str.repeat(" ", style.indent * list.len(path))
    for k in 0..split
        text = line_after(text, pad + pair_line(pairs[k], style, pad))
    for k in split..n
        var here = path[:]
        list.push(here, pairs[k].key)
        text = section(pairs[k].value, here, style, text)
    text

// A header, or the headers of an array of tables, and what is under
// them.  `v` is a table or an array of tables.  A table holding only
// tables needs no header of its own.
fn section(v: TomlValue, path: [Str], style: TomlStyle, out: Str) -> Str
    var text = out
    let pad = str.repeat(" ", style.indent * (list.len(path) - 1))
    if let TomlTable(pairs) = v
        if has_plain(pairs, style) or list.len(pairs) == 0
            text = header_line(text, pad + "[" + tomlparse.path_text(path) + "]", style)
        return body(pairs, path, style, text)
    if let TomlArray(items) = v
        for item in items
            text = header_line(text, pad + "[[" + tomlparse.path_text(path) + "]]", style)
            if let TomlTable(pairs) = item
                text = body(pairs, path, style, text)
    text

// Whether a table has a key that is written as `key = value` rather
// than as a header of its own.
fn has_plain(pairs: [TomlPair], style: TomlStyle) -> Bool
    for pr in pairs
        if not headed(pr.value, style)
            return true
    false

// Whether a value in a table's tail is written under a header: an
// array of tables always, a table when the style prefers headers.
fn headed(v: TomlValue, style: TomlStyle) -> Bool
    if tomlnode.type_of(v) == TypeTable
        return style.prefer_headers
    is_array_of_tables(v)

fn is_array_of_tables(v: TomlValue) -> Bool
    if let TomlArray(items) = v
        if list.len(items) == 0
            return false
        for x in items
            if tomlnode.type_of(x) != TypeTable
                return false
        return true
    false

fn line_after(text: Str, line: Str) -> Str
    if text == ""
        return line
    text + "\n" + line

// A header line, after a blank line when the style asks for one and
// something was written before it.
fn header_line(text: Str, line: Str, style: TomlStyle) -> Str
    if text == ""
        return line
    if style.blank_before_table
        return text + "\n\n" + line
    text + "\n" + line

// `key = value`, with a long array wrapped one item per line.
fn pair_line(pr: TomlPair, style: TomlStyle, pad: Str) -> Str
    let prefix = tomlparse.key_text(pr.key) + " = "
    let one = value_to_string(pr.value)
    if let TomlArray(items) = pr.value
        let fits = style.array_width == 0 or str.len(pad) + str.len(prefix) + str.len(one) <= style.array_width
        if not fits and list.len(items) > 0
            var lines = prefix + "["
            for x in items
                lines = lines + "\n" + pad + "    " + value_to_string(x) + ","
            return lines + "\n" + pad + "]"
    prefix + one

// `{ key = value, … }`, or `{}`.
fn inline_table(pairs: [TomlPair]) -> Str
    if list.len(pairs) == 0
        return "{}"
    var parts: [Str] = []
    for pr in pairs
        list.push(parts, tomlparse.key_text(pr.key) + " = " + value_to_string(pr.value))
    "{ " + str.join(parts, ", ") + " }"

// A float as TOML spells it: `inf`, `-inf` and `nan` for the special
// values, and otherwise the shortest decimal that reads back as the
// same value, with `.0` added when it has neither a point nor an
// exponent, because TOML reads `2` as an integer.
fn float_text(f: Float) -> Str
    if math.is_nan(f)
        return "nan"
    if f > 1.7976931348623157e308
        return "inf"
    if f < 0.0 - 1.7976931348623157e308
        return "-inf"
    let t = "${f}"
    if str.contains(t, ".") or str.contains(t, "e") or str.contains(t, "E")
        return t
    t + ".0"

// The first key defined twice in any table under `v`, or `None`.
fn duplicate_in(v: TomlValue, path: [Str]) -> ?TomlError
    match v
        TomlTable(pairs) =>
            for i in 0..list.len(pairs)
                var here = path[:]
                list.push(here, pairs[i].key)
                for j in 0..i
                    if pairs[j].key == pairs[i].key
                        return Some(DuplicateKey(0 - 1, 0 - 1, tomlparse.path_text(here), 0 - 1))
                if let Some(e) = duplicate_in(pairs[i].value, here)
                    return Some(e)
            None
        TomlArray(items) =>
            for x in items
                if let Some(e) = duplicate_in(x, path)
                    return Some(e)
            None
        _                => None
