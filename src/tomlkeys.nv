// tomlkeys.nv — reaching into a parsed document by key and by path.
//
// Every lookup comes in two forms, and they answer different questions:
//
//   `get`, `str_at`, `int_at`, …    ->  Result<T, TomlError>
//   `find`, `opt_str`, `opt_int`, …  ->  ?T
//
// The `Result` form is for a required setting.  It tells
// `NoSuchKey("db.port")` from `WrongType("db.port", "integer",
// "string")`, two different sentences to show a user and two different
// fixes.  The optional form is for a setting with a default, where
// "absent" and "the wrong shape" both mean "use the default".
//
// A dotted path is written the way the document writes keys:
// `"servers.alpha.port"` walks tables the way `[servers.alpha]` builds
// them, and `a."b.c"` is two segments with a dot inside the second.  A
// path copied out of the file works.  `path_segments` is the split on
// its own.
//
// An array index is not part of the path language.  `0` is a legal
// bare key and TOML has no index syntax, so `a.0` names the key `0` of
// the table `a`.  `at` takes an index as an argument instead.

use civil
use tomlnode
use tomlparse

// The value at a dotted path, or why not.
//
// `NoSuchKey` names the path as the caller wrote it.  A path through a
// value that is not a table is `WrongType`, naming the part of the path
// that holds the value.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     match tomlkeys.get(doc, "db.port")
//         Ok(v)  => println(tomlnode.type_name(v))   // integer
//         Err(e) => println(e.message())
// ```
pub fn get(v: TomlValue, path: Str) -> Result<TomlValue, TomlError>
    let segs = path_segments(path)!
    var cur = v
    for i in 0..list.len(segs)
        if tomlnode.type_of(cur) != TypeTable
            return Err(WrongType(tomlparse.path_text(segs[0:i]), "table", tomlnode.type_name(cur)))
        match child(cur, segs[i])
            Some(next) =>
                cur = next
            None       =>
                return Err(NoSuchKey(path))
    Ok(cur)

// The value at a dotted path, or `None` for every reason `get` would
// give.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     match tomlkeys.find(doc, "db.host")
//         Some(_) => println("set")
//         None    => println("unset")
// ```
pub fn find(v: TomlValue, path: Str) -> ?TomlValue
    match get(v, path)
        Ok(x)  => Some(x)
        Err(_) => None

// Whether a path resolves.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     println("${tomlkeys.has(doc, "db.port")}")     // true
// ```
pub fn has(v: TomlValue, path: Str) -> Bool
    find(v, path) != None

// One key of one table, with no path walking at all.
//
// For a caller whose key contains a dot it does not want read as a
// separator.  `None` for a value that is not a table.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("\"a.b\" = 1\n")!
//     match tomlkeys.child(doc, "a.b")
//         Some(_) => println("found the literal key")
//         None    => println("no")
// ```
pub fn child(v: TomlValue, key: Str) -> ?TomlValue
    match v
        TomlTable(pairs) =>
            let at = index_of_key(pairs, key)
            if at < 0
                return None
            Some(pairs[at].value)
        _                => None

// One element of an array, by 0-based index.
//
// `None` past the end, for a negative index, and for a value that is
// not an array.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("a = [10, 20]\n")!
//     let arr = tomlkeys.get(doc, "a")!
//     match tomlkeys.at(arr, 1)
//         Some(_) => println("20 is there")
//         None    => println("no")
// ```
pub fn at(v: TomlValue, index: Int) -> ?TomlValue
    if let TomlArray(items) = v
        if index >= 0 and index < list.len(items)
            return Some(items[index])
    None

// A dotted path split into its segments, with TOML's quoting applied.
//
// `"a.\"b.c\".d"` is `["a", "b.c", "d"]`.  A malformed path, such as
// an unclosed quote or an empty segment, is `BadKey` at line 1 and the
// column within the path.
//
// ```novo
// use tomlkeys
//
// fn main() [io]
//     let segs = tomlkeys.path_segments("servers.alpha.port")!
//     println("${list.len(segs)}")              // 3
// ```
pub fn path_segments(path: Str) -> Result<[Str], TomlError>
    tomlparse.parse_key_text(path)

// Segments joined back into a dotted path, quoting the ones that need
// it.
//
// The inverse of `path_segments`.  A segment holding anything but
// ASCII letters, digits, `_` and `-` comes back quoted and escaped, so
// the result is a path `path_segments` accepts and a person can paste.
//
// ```novo
// use tomlkeys
//
// fn main() [io]
//     println(tomlkeys.path_of(["a", "b.c"]))   // a."b.c"
// ```
pub fn path_of(segments: [Str]) -> Str
    tomlparse.path_text(segments)

// Every path in a document, depth first, in document order.
//
// Leaves only: a table's own path is not listed, its keys' are, and an
// array is one leaf.  It is what a `--dump` flag prints and what a diff
// between two configuration files compares.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     println(list.join(tomlkeys.paths(doc), " "))   // db.port
// ```
pub fn paths(v: TomlValue) -> [Str]
    var out: [Str] = []
    leaves(v, [], out)
    out

// The string at a path, or why not.
//
// `WrongType` when the path holds something else.  The value is not
// coerced: `port = 8080` read as a string is a mistake in the caller or
// in the file, and answering `"8080"` would hide which.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nhost = \"localhost\"\n")!
//     println(tomlkeys.str_at(doc, "db.host")!)      // localhost
// ```
pub fn str_at(v: TomlValue, path: Str) -> Result<Str, TomlError>
    match get(v, path)!
        TomlStr(s) => Ok(s)
        other      => Err(WrongType(path, "string", tomlnode.type_name(other)))

// The integer at a path, or why not.
//
// A `TomlFloat` is `WrongType` even when it is integral: `1.0` and `1`
// are different literals in TOML.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("port = 8080\n")!
//     println("${tomlkeys.int_at(doc, "port")!}")    // 8080
// ```
pub fn int_at(v: TomlValue, path: Str) -> Result<Int, TomlError>
    match get(v, path)!
        TomlInt(n) => Ok(n)
        other      => Err(WrongType(path, "integer", tomlnode.type_name(other)))

// The float at a path, or why not.
//
// A `TomlInt` is accepted and widened.  This is the one asymmetry:
// `timeout = 30` in a field of seconds with fractions is a round
// number, not a type error.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("timeout = 30\n")!
//     println("${tomlkeys.float_at(doc, "timeout")!}")   // 30
// ```
pub fn float_at(v: TomlValue, path: Str) -> Result<Float, TomlError>
    match get(v, path)!
        TomlFloat(f) => Ok(f)
        TomlInt(n)   => Ok(n as Float)
        other        => Err(WrongType(path, "float", tomlnode.type_name(other)))

// The boolean at a path, or why not.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("debug = true\n")!
//     println("${tomlkeys.bool_at(doc, "debug")!}")  // true
// ```
pub fn bool_at(v: TomlValue, path: Str) -> Result<Bool, TomlError>
    match get(v, path)!
        TomlBool(b) => Ok(b)
        other       => Err(WrongType(path, "boolean", tomlnode.type_name(other)))

// The array at a path, as its items.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("ports = [80, 443]\n")!
//     println("${list.len(tomlkeys.array_at(doc, "ports")!)}")   // 2
// ```
pub fn array_at(v: TomlValue, path: Str) -> Result<[TomlValue], TomlError>
    match get(v, path)!
        TomlArray(items) => Ok(items[:])
        other            => Err(WrongType(path, "array", tomlnode.type_name(other)))

// The table at a path, as its pairs in document order.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     println("${list.len(tomlkeys.table_at(doc, "db")!)}")      // 1
// ```
pub fn table_at(v: TomlValue, path: Str) -> Result<[TomlPair], TomlError>
    match get(v, path)!
        TomlTable(pairs) => Ok(pairs[:])
        other            => Err(WrongType(path, "table", tomlnode.type_name(other)))

// The string at a path, or `None`.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\n")!
//     println(tomlkeys.opt_str(doc, "db.host") ?? "127.0.0.1")
// ```
pub fn opt_str(v: TomlValue, path: Str) -> ?Str
    match str_at(v, path)
        Ok(x)  => Some(x)
        Err(_) => None

// The integer at a path, or `None`.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\n")!
//     println("${tomlkeys.opt_int(doc, "db.port") ?? 5432}")
// ```
pub fn opt_int(v: TomlValue, path: Str) -> ?Int
    match int_at(v, path)
        Ok(x)  => Some(x)
        Err(_) => None

// The float at a path, or `None`.  Widens an integer, as `float_at`
// does.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("timeout = 30\n")!
//     println("${tomlkeys.opt_float(doc, "timeout") ?? 5.0}")
// ```
pub fn opt_float(v: TomlValue, path: Str) -> ?Float
    match float_at(v, path)
        Ok(x)  => Some(x)
        Err(_) => None

// The boolean at a path, or `None`.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[log]\n")!
//     println("${tomlkeys.opt_bool(doc, "log.debug") ?? false}")
// ```
pub fn opt_bool(v: TomlValue, path: Str) -> ?Bool
    match bool_at(v, path)
        Ok(x)  => Some(x)
        Err(_) => None

// The offset date-time at a path: the civil parts and minutes east of
// UTC.
//
// Only `TomlOffsetDateTime` answers.  A local date-time is
// `WrongType`: supplying `0` would invent UTC.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("at = 1979-05-27T07:32:00Z\n")!
//     let (_, off) = tomlkeys.offset_datetime_at(doc, "at")!
//     println("${off}")                         // 0
// ```
pub fn offset_datetime_at(v: TomlValue, path: Str) -> Result<(civil.CivilDateTime, Int), TomlError>
    match get(v, path)!
        TomlOffsetDateTime(dt, off) => Ok((dt, off))
        other                       => Err(WrongType(path, "offset date-time", tomlnode.type_name(other)))

// The local date-time at a path.
//
// Only `TomlLocalDateTime` answers.  An offset date-time is
// `WrongType`, because dropping the offset would move the timestamp.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("at = 1979-05-27T07:32:00\n")!
//     let _ = tomlkeys.local_datetime_at(doc, "at")!
//     println("ok")
// ```
pub fn local_datetime_at(v: TomlValue, path: Str) -> Result<civil.CivilDateTime, TomlError>
    match get(v, path)!
        TomlLocalDateTime(dt) => Ok(dt)
        other                 => Err(WrongType(path, "local date-time", tomlnode.type_name(other)))

// The local date at a path.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("day = 1979-05-27\n")!
//     let _ = tomlkeys.date_at(doc, "day")!
//     println("ok")
// ```
pub fn date_at(v: TomlValue, path: Str) -> Result<civil.CivilDate, TomlError>
    match get(v, path)!
        TomlLocalDate(d) => Ok(d)
        other            => Err(WrongType(path, "local date", tomlnode.type_name(other)))

// The local time at a path.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("at = 07:32:00\n")!
//     let _ = tomlkeys.time_at(doc, "at")!
//     println("ok")
// ```
pub fn time_at(v: TomlValue, path: Str) -> Result<civil.CivilTime, TomlError>
    match get(v, path)!
        TomlLocalTime(t) => Ok(t)
        other            => Err(WrongType(path, "local time", tomlnode.type_name(other)))

// A copy of the document with the value at a path replaced or added.
//
// The answer is a new tree; the one given is unchanged.  Missing
// intermediate tables are created, in the order the path names them,
// and appended at the end of their parent.  An intermediate segment
// that holds something other than a table is `WrongType` rather than
// an overwrite, because replacing `a = 1` when told to set `a.b` loses
// a setting.  A root that is not a table is `WrongType` with the path
// `""`.
//
// A tool that wants a person's comments kept wants `tomledit`
// instead.
//
// ```novo
// use tomlread
// use tomlkeys
// use tomlnode
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     let next = tomlkeys.set(doc, "db.port", TomlInt(5433))!
//     println("${tomlkeys.int_at(next, "db.port")!}")    // 5433
// ```
pub fn set(v: TomlValue, path: Str, value: TomlValue) -> Result<TomlValue, TomlError>
    let segs = path_segments(path)!
    if tomlnode.type_of(v) != TypeTable
        return Err(WrongType("", "table", tomlnode.type_name(v)))
    set_in(v, segs, 0, value)

// A copy of the document with the value at a path removed.
//
// `NoSuchKey` when it was not there, so a typo is reported.  An empty
// table left behind stays: pruning it would delete a `[section]` a
// person wrote on purpose.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let doc = tomlread.parse("[db]\nport = 5432\n")!
//     let next = tomlkeys.remove(doc, "db.port")!
//     println("${tomlkeys.has(next, "db.port")}")        // false
// ```
pub fn remove(v: TomlValue, path: Str) -> Result<TomlValue, TomlError>
    let segs = path_segments(path)!
    match removed(v, segs, 0)
        Some(next) => Ok(next)
        None       => Err(NoSuchKey(path))

// A copy of `base` with every leaf of `overlay` written over it.
//
// Tables merge key by key, and everything else replaces whole: an
// array in `overlay` replaces the array in `base` rather than being
// appended to it.  Keys only in `base` survive; keys only in `overlay`
// are appended in `overlay`'s order.  Either argument not being a
// table is `WrongType` with the path `""`.
//
// ```novo
// use tomlread
// use tomlkeys
//
// fn main() [io]
//     let base = tomlread.parse("[db]\nport = 5432\nhost = \"a\"\n")!
//     let over = tomlread.parse("[db]\nport = 6000\n")!
//     let m = tomlkeys.merge(base, over)!
//     println("${tomlkeys.int_at(m, "db.port")!}")       // 6000
//     println(tomlkeys.str_at(m, "db.host")!)            // a
// ```
pub fn merge(base: TomlValue, overlay: TomlValue) -> Result<TomlValue, TomlError>
    if tomlnode.type_of(base) != TypeTable
        return Err(WrongType("", "table", tomlnode.type_name(base)))
    if tomlnode.type_of(overlay) != TypeTable
        return Err(WrongType("", "table", tomlnode.type_name(overlay)))
    Ok(merged(base, overlay))

// Every leaf path under `v`, depth first, written into `out`.
fn leaves(v: TomlValue, above: [Str], var out: [Str])
    if let TomlTable(pairs) = v
        for pr in pairs
            var here = above[:]
            list.push(here, pr.key)
            if tomlnode.type_of(pr.value) == TypeTable
                leaves(pr.value, here, out)
            else
                list.push(out, path_of(here))

// The table `t` with the value at `segs[i..]` set, creating the tables
// on the way.  `t` is a table.
fn set_in(t: TomlValue, segs: [Str], i: Int, value: TomlValue) -> Result<TomlValue, TomlError>
    var pairs: [TomlPair] = []
    if let TomlTable(ps) = t
        pairs = ps[:]
    let key = segs[i]
    let last = i == list.len(segs) - 1
    for k in 0..list.len(pairs)
        if pairs[k].key == key
            if last
                pairs[k] = TomlPair { key: key, value: value }
                return Ok(TomlTable(pairs))
            let inner = pairs[k].value
            if tomlnode.type_of(inner) != TypeTable
                return Err(WrongType(path_of(segs[0:i + 1]), "table", tomlnode.type_name(inner)))
            pairs[k] = TomlPair { key: key, value: set_in(inner, segs, i + 1, value)! }
            return Ok(TomlTable(pairs))
    if last
        list.push(pairs, TomlPair { key: key, value: value })
    else
        list.push(pairs, TomlPair { key: key, value: set_in(tomlnode.empty_table(), segs, i + 1, value)! })
    Ok(TomlTable(pairs))

// `v` with the key at `segs[i..]` removed, or `None` when it is not
// there.
fn removed(v: TomlValue, segs: [Str], i: Int) -> ?TomlValue
    if let TomlTable(ps) = v
        var pairs = ps[:]
        let last = i == list.len(segs) - 1
        for k in 0..list.len(pairs)
            if pairs[k].key == segs[i]
                if last
                    var rest: [TomlPair] = []
                    for j in 0..list.len(pairs)
                        if j != k
                            list.push(rest, pairs[j])
                    return Some(TomlTable(rest))
                let Some(inner) = removed(pairs[k].value, segs, i + 1) else
                    return None
                pairs[k] = TomlPair { key: segs[i], value: inner }
                return Some(TomlTable(pairs))
    None

// Two tables merged key by key, as `merge` describes.
fn merged(base: TomlValue, overlay: TomlValue) -> TomlValue
    var pairs: [TomlPair] = []
    if let TomlTable(ps) = base
        pairs = ps[:]
    if let TomlTable(over) = overlay
        for o in over
            var at = 0 - 1
            for k in 0..list.len(pairs)
                if at < 0 and pairs[k].key == o.key
                    at = k
            if at < 0
                list.push(pairs, o)
            else if tomlnode.type_of(pairs[at].value) == TypeTable and tomlnode.type_of(o.value) == TypeTable
                pairs[at] = TomlPair { key: o.key, value: merged(pairs[at].value, o.value) }
            else
                pairs[at] = o
    TomlTable(pairs)

// The index of the first pair with this key, or -1.
fn index_of_key(pairs: [TomlPair], key: Str) -> Int
    for i in 0..list.len(pairs)
        if pairs[i].key == key
            return i
    0 - 1
